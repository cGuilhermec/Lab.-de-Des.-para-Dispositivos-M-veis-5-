// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")  // ← ESTA LINHA É OBRIGATÓRIA na v6
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  accessLevel String   @default("visualizacao")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}