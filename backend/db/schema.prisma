// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // NÃO inclua a URL aqui - ela vai no .env
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  accessLevel String   @default("visualizacao")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}